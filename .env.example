# Copy to .env.local and fill with values from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Dashboard → Authentication → URL configuration:
# - Site URL: http://localhost:3000 (dev)
# - Redirect URLs: http://localhost:3000/auth/callback

# Optional: Mapbox for Location view (dark map + geocoding). Without these, maps use Leaflet + OSM and Nominatim.
# MAPBOX_ACCESS_TOKEN=pk....   # server: forward/reverse geocode (can match public token)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk....  # client: Mapbox GL map tiles
