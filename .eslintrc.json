{
  "extends": ["next/core-web-vitals", "prettier"],
  "rules": {
    "prefer-const": "error",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["lib/types/database.types.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["lib/hooks/useAuth.ts"],
